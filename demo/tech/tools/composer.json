{
  "name": "tech/tools",
  "type": "library",
  "version": "1.0.0",
  "authors": [
    {
      "name": "Alexey Shmelev",
      "email": "alexsey_89@bk.ru"
    }
  ],
  "autoload": {
    "psr-4": {
      "Tools\\": "src/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0.5",
    "bamarni/composer-bin-plugin": "^1.9.1"
  },
  "extra": {
    "bamarni-bin": {
      "bin-links": false,
      "target-directory": "t",
      "forward-command": true
    }
  },
  "scripts": {
    "bump-dev": [
      "@composer bump --dev-only",
      "@composer bin all bump --dev-only"
    ]
  },
  "config": {
    "process-timeout": 0,
    "sort-packages": true,
    "bump-after-update": true,
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    }
  }
}
