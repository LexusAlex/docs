{
  "name": "tech/shared",
  "type": "project",
  "authors": [
    {
      "name": "Alexey Shmelev",
      "email": "alexsey_89@bk.ru"
    }
  ],
  "autoload": {
    "psr-4": {
      "Shared\\": "src/"
    }
  },
  "require": {
    "php": ">=8.5"
  },
  "scripts": {
    "phpunit": "/tools/t/phpunit/vendor/bin/phpunit --colors=always --configuration=etc/phpunit.xml",
    "phpunit-coverage": "/tools/t/phpunit/vendor/bin/phpunit --colors=always --configuration=etc/phpunit.xml --coverage-html var/cache/coverage --coverage-xml=var/cache/coverage-xml --log-junit=var/cache/junit.xml",
    "infection": "/tools/t/infection/vendor/bin/infection --show-mutations --log-verbosity=default --min-covered-msi=100 --threads=4 --coverage=../var/cache --configuration=etc/infection.json5",
    "phpstan": "/tools/t/phpstan/vendor/bin/phpstan analyse -c etc/phpstan.neon",
    "psalm": "/tools/t/psalm/vendor/bin/psalm --config=etc/psalm.xml",
    "require-checker": "/tools/t/composer-require-checker/vendor/bin/composer-require-checker check --config-file=etc/composer-require-checker.json",
    "unused": "/tools/t/composer-unused/vendor/bin/composer-unused",
    "php-cs-fixer-dry-run": "/tools/t/php-cs-fixer/vendor/bin/php-cs-fixer fix --dry-run --config etc/.php-cs-fixer.php --diff --show-progress=bar",
    "php-cs-fixer": "/tools/t/php-cs-fixer/vendor/bin/php-cs-fixer fix --config etc/.php-cs-fixer.php --diff --show-progress=bar"
  }
}
