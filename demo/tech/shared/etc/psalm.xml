<?xml version="1.0"?>
<psalm
    autoloader="../../tools/t/phpunit/vendor/autoload.php"
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config ../../tools/t/psalm/vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="false"
    findUnusedCode="false"
    allowStringToStandInForClass="false"
    cacheDirectory="../var/cache/.psalm"
>
    <stubs>
        <file name="../../tools/t/psalm/vendor/psalm/plugin-phpunit/stubs/TestCase.phpstub" />
    </stubs>

    <projectFiles>
        <directory name="../src" />
        <ignoreFiles>
            <directory name="../src/Core/Test/Bootstrap/ConfigurationLoader/fixtures" />
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <InvalidAttribute errorLevel="info" />
    </issueHandlers>
</psalm>
