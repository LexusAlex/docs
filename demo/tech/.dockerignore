# -------------------------------------------------
# Глобальные исключения (применяются ко всему проекту)
# -------------------------------------------------

# Система контроля версий
.git
.gitignore
.gitattributes

# Файлы окружения (их нужно монтировать, не копировать)
.env
.env.*
!.env.example

# IDE и редакторы
.idea/
.vscode/
*.swp
*.swo
*~

# Логи и кэш
*.log
var/cache/
var/log/
storage/logs/

# Операционная система
.DS_Store
Thumbs.db

# Документация и README
README.md
docs/
*.md

# -------------------------------------------------
# Исключения для конкретных пакетов
# -------------------------------------------------

# Зависимости Composer (мы устанавливаем их внутри Docker)
api/vendor/
shared/vendor/
ui/vendor/
tools/vendor/
tools/t

# Зависимости NPM (если есть в ui)
ui/node_modules/

# Тесты и отчеты (обычно не нужны в production-образе)
api/tests/
api/phpunit.xml
shared/tests/
ui/tests/
tools/tests/

# Временные файлы сборки
build/
dist/

# -------------------------------------------------
# Исключаем сами Docker-файлы (если они не нужны внутри)
# -------------------------------------------------
docker-compose*.yaml
Dockerfile*
Makefile